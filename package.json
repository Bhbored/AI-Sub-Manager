{
  "name": "ai-usage-monitor",
  "version": "1.0.0",
  "description": "Local AI subscription usage monitor",
  "main": "dist-electron/desktop/main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "npm run build:desktop && npm run build:ui && tsc -p tsconfig.ui.json && tsc -p tsconfig.scripts.json",
    "test": "tsc -p tsconfig.tests.json && node --test generated/tests/tests/*.test.js",
    "dist": "npm run build && node scripts/dist.ts",
    "version:bump": "node scripts/bump-version.ts",
    "build:desktop": "tsc -p tsconfig.desktop.json",
    "build:ui": "tailwindcss -i src/ui/theme.css -o generated/theme.css --minify && vite build --configLoader native"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.4.3",
    "electron-builder": "^26.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "^7.0.0",
    "@tailwindcss/cli": "4.3.5"
  },
  "build": {
    "appId": "local.aiusagemonitor.app",
    "productName": "AI Usage Monitor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "AI-Usage-Monitor-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "dist-electron/providers/claude/statusline.cjs"
    ]
  }
}
