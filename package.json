{
  "name": "ai-usage-monitor",
  "version": "1.0.0",
  "description": "Local AI subscription usage monitor",
  "main": "src/main/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "vite build --configLoader native",
    "test": "node --test tests/*.test.mjs",
    "dist": "npm run build && node scripts/dist.mjs",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.4.3",
    "electron-builder": "^26.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "local.aiusagemonitor.app",
    "productName": "AI Usage Monitor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/worker/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "AI-Usage-Monitor-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "src/main/providers/claude/statusline.cjs"
    ]
  }
}
